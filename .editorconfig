# EditorConfig is awesome: https://editorconfig.org

root = true

# Default settings
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_size = 4
max_line_length = 79

# HTML files
[*.html]
indent_size = 2

# JSON files
[*.json]
indent_size = 2